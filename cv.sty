% ----------------------------------------------------------- Custom commands
\newcommand{\resitem}[1]{
\item #1 \vspace{-2pt}
}
\newcommand{\resheading}[1]{%
  {\LARGE \parashade[.9]{sharpcorners}{\textbf{#1 \vphantom{p\^{E}}}}}
  \par\vspace{-0.28in} % Increased negative space to pull the line up
  \noindent
  \begin{tikzpicture}[baseline]%\
    \shade[left color=SwishLineColour!60!white, right color=white] rectangle (\linewidth,2.5pt);
  \end{tikzpicture}%
}

% company (possibly with multiple roles)
\newcommand{\company}[4]{%
  \noindent
  \begin{tabular*}{\linewidth}{l@{\extracolsep{\fill}}r}
    \large \textbf{#1} & #2
    \if\relax\detokenize{#3}\relax
    \\[6pt] % No content in #3, just end the line normally
    \else
    \\[2pt] % Content exists, add the extra 2pt gap
    \textbf{#3} & \textit{#4} \\
    \fi
  \end{tabular*}
}

% a single role, only use if you've used rescompany
\newcommand{\role}[2]{%
  \vspace{0.025in}
  \noindent
  \begin{tabular*}{\linewidth}{l@{\extracolsep{\fill}}r}
    \textbf{#1} & \small \textit{#2} \\ [2pt]
  \end{tabular*}
}
\newcommand{\makefield}[2]{\makebox[1.5em]{\color{MarkerColour!80!black}#1} #2\hspace{2em}}

\newcommand{\education}[4]{%
  \noindent
  \begin{tabular*}{\linewidth}{l@{\extracolsep{\fill}}r}
    \textbf{#1} & \textit{#2} \\
    \textit{#3} & #4 \\
  \end{tabular*}
  \vspace{0.05in}
}
